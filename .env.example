# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API). The publishable/anon key is safe for the browser:
# all data access is protected by Row Level Security. Use a project dedicated to Essay Studio.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older projects can use the legacy anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# No service-role key is needed or used: every query runs as the signed-in user.

# Anthropic (console.anthropic.com → API keys). Server-only: never prefix with NEXT_PUBLIC_.
# Without it, writing, checks and export still work; AI buttons explain how to enable AI.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: maximum AI requests per user per hour (default 40).
# AI_RATE_LIMIT_PER_HOUR=40

# Test only — deterministic AI fixtures for automated tests. Ignored in production builds.
# AI_MOCK_RESPONSES=1
